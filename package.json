{
  "name": "agentscope-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "agent:dev": ".venv/bin/python -m uvicorn service.main:app --host 127.0.0.1 --port 8790 --reload --reload-dir service",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "typegen": "WRANGLER_LOG_PATH=.wrangler/types.log wrangler types --config worker/wrangler.types.jsonc worker-configuration.d.ts",
    "test:service": ".venv/bin/python -m unittest discover -s tests -p 'test_*.py' -v",
    "files:assets": "node scripts/copy-file-preview-assets.mjs",
    "predev": "node scripts/copy-file-preview-assets.mjs",
    "prebuild": "node scripts/copy-file-preview-assets.mjs",
    "build:vercel": "npm run files:assets && next build --webpack"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.30",
    "@assistant-ui/react-markdown": "^0.14.23",
    "@base-ui/react": "^1.9.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "clsx": "^2.1.1",
    "docx-preview": "^0.4.1",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.3",
    "heat-graph": "^0.0.25",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "pdfjs-dist": "^6.4.299",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
