AGENTSCOPE_SERVICE_URL=http://127.0.0.1:8790

# OpenAI-compatible model
AGENTSCOPE_PROVIDER=openai
AGENTSCOPE_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Kimi / Moonshot
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k
KIMI_BASE_URL=https://api.moonshot.cn/v1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Doubao / Volcengine Ark OpenAI-compatible endpoint
DOUBAO_API_KEY=
DOUBAO_MODEL=
DOUBAO_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=

# DashScope / Qwen
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Any OpenAI-compatible service
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_BASE_URL=

# Optional Fernet key for message channel credentials. If omitted, a local
# service/state/channel.key is generated. Keep the same key when migrating DBs.
# AGENTSCOPE_CHANNEL_KEY=
