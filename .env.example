AGENTSCOPE_SERVICE_URL=http://127.0.0.1:8790

# OpenAI-compatible model
AGENTSCOPE_PROVIDER=openai
AGENTSCOPE_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Kimi / Moonshot
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k
KIMI_BASE_URL=https://api.moonshot.cn/v1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Doubao / Volcengine Ark OpenAI-compatible endpoint
DOUBAO_API_KEY=
DOUBAO_MODEL=
DOUBAO_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=

# DashScope / Qwen
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Any OpenAI-compatible service
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_BASE_URL=

# Optional Fernet key for message channel credentials. If omitted, a local
# service/state/channel.key is generated. Keep the same key when migrating DBs.
# AGENTSCOPE_CHANNEL_KEY=

# Private conversation files. Supabase receives encrypted .enc objects even in
# a public bucket. Never expose these server-only keys through NEXT_PUBLIC_*.
SUPABASE_URL=https://bmfppeqixqhinyklhbzo.supabase.co
SUPABASE_STORAGE_BUCKET=xixi-agentscope-studio
# SUPABASE_SECRET_KEY=
# Or the legacy server-side service_role key:
# SUPABASE_SERVICE_ROLE_KEY=
# Auto selects supabase when a server key is present, otherwise durable local.
# AGENTSCOPE_FILE_STORAGE=supabase
# Strongly recommended for multi-host deployments/backups: a stable 32-byte
# URL-safe Base64 key. Otherwise service/state/file-storage.key is created.
# AGENTSCOPE_FILE_KEY=
# AGENTSCOPE_SOFFICE=/path/to/soffice
# AGENTSCOPE_FFMPEG=/path/to/ffmpeg
# AGENTSCOPE_FONT=/path/to/chinese-font.ttf
# ASR weights load on first use; use a local directory for offline deployments.
# AGENTSCOPE_WHISPER_MODEL=tiny

# Enable only with a configured multimodal model; AgentScope ImageParser sends
# a 512px preview as an actual image block. Text-only models may reject it.
# AGENTSCOPE_FILE_VISION_INPUT=false

# Knowledge RAG: independent from chat-model settings. Empty model keeps indexing in needs_config.
XIXI_KB_EMBEDDING_PROVIDER=openai
XIXI_KB_EMBEDDING_MODEL=
XIXI_KB_EMBEDDING_BASE_URL=
XIXI_KB_EMBEDDING_DIMENSIONS=1024
XIXI_KB_EMBEDDING_API_KEY=
# Optional Qdrant Cloud. Empty URL uses native Qdrant local persistence, no Docker required.
XIXI_KB_QDRANT_URL=
XIXI_KB_QDRANT_API_KEY=
# Cloudflare multilingual embedding example:
# XIXI_KB_EMBEDDING_MODEL=@cf/baai/bge-m3
# XIXI_KB_EMBEDDING_BASE_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1
# XIXI_KB_EMBEDDING_API_KEY=YOUR_WORKERS_AI_API_TOKEN
