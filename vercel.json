{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "nextjs",
      "buildCommand": "npm run build:vercel",
      "bindings": [
        { "type": "service", "service": "backend", "format": "url", "env": "AGENTSCOPE_SERVICE_URL" }
      ]
    },
    "backend": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "service.main:app",
      "functions": {
        "service/main.py": {
          "maxDuration": 300,
          "excludeFiles": "{node_modules/**,.next/**,dist/**,public/**,tests/**,PRD/**,upstream/**,local/**,outputs/**,.venv/**,.env*,.git/**}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
