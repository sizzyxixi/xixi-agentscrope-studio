PORT=8790
AGENTSCOPE_STATE_DB=/data/state.sqlite3
AGENTSCOPE_FILE_STORAGE=supabase
# Preserve Vercel demo behavior during acceptance, while local scheduling is active.
# Enable persistent workers only after coordinating the single scheduler owner.
AGENTSCOPE_SERVERLESS=1
DATABASE_URL=
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=
SUPABASE_SECRET_KEY=
AGENTSCOPE_FILE_KEY=
AGENTSCOPE_KNOWLEDGE_KEY=
AGENTSCOPE_CHANNEL_KEY=
# Required only for encrypted personal MCP credentials on PostgreSQL.
AGENTSCOPE_MCP_KEY=

# Platform administration uses the existing authenticated account system.
AGENTSCOPE_PLATFORM_ADMIN_USERS=admin
